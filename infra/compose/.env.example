# Copy this file to .env (same folder) and fill in real values.
# .env is ignored by git and must never be committed.

# MySQL root password (used only by the MySQL container)
DB_ROOT_PASSWORD=change-me-root

# App database user (must NOT be "root") and its password
DB_USERNAME=sales_app
DB_PASSWORD=change-me

# JWT signing secret: at least 32 characters, long random value
JWT_SECRET=change-me-to-a-long-random-string-at-least-32-chars

# Optional overrides
# ML_SERVICE_URL=http://host.docker.internal:8000
# CORS_ALLOWED_ORIGINS=http://localhost:5173