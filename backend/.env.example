# Spring profile: "dev" (default) or "prod". Production MUST set prod.
SPRING_PROFILES_ACTIVE=dev

# Database (MySQL). Required in prod; dev falls back to root/root.
DB_USERNAME=root
DB_PASSWORD=change-me

# JWT signing secret: at least 32 characters. Required in prod (no fallback).
JWT_SECRET=change-me-to-a-long-random-string-at-least-32-chars

# ML service (FastAPI) base URL and timeout
ML_SERVICE_URL=http://localhost:8000
ML_SERVICE_TIMEOUT_MS=5000

# CORS: comma-separated list of allowed frontend origins
CORS_ALLOWED_ORIGINS=http://localhost:5173

# Login brute-force protection
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCK_MINUTES=15

# Initial admin. REQUIRED once in prod to replace the insecure seeded password (min 8 chars).
ADMIN_PASSWORD=
